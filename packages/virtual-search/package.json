{
  "name": "virtual-search",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./react-window": {
      "types": "./dist/react-window/index.d.ts",
      "import": "./dist/react-window/index.js"
    },
    "./react-virtuoso": {
      "types": "./dist/react-virtuoso/index.d.ts",
      "import": "./dist/react-virtuoso/index.js"
    },
    "./tanstack": {
      "types": "./dist/tanstack/index.d.ts",
      "import": "./dist/tanstack/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js"
    },
    "./worker/runtime": {
      "import": "./dist/worker/runtime.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@tanstack/react-virtual": "^3.13.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-virtual": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-virtual": "^3.13.12",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "jsdom": "^26.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsup": "^8.5.0",
    "vitest": "^3.2.4"
  }
}
