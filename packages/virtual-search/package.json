{
  "name": "virtual-search",
  "version": "0.1.2",
  "description": "Native-like find-in-page across DOM and virtualized content, with React and Vue integrations.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamikaz1k/virtual-search.git",
    "directory": "packages/virtual-search"
  },
  "homepage": "https://github.com/kamikaz1k/virtual-search#readme",
  "bugs": {
    "url": "https://github.com/kamikaz1k/virtual-search/issues"
  },
  "keywords": [
    "find-in-page",
    "search",
    "virtualization",
    "react",
    "vue"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./react-window": {
      "types": "./dist/react-window/index.d.ts",
      "import": "./dist/react-window/index.js",
      "default": "./dist/react-window/index.js"
    },
    "./react-virtuoso": {
      "types": "./dist/react-virtuoso/index.d.ts",
      "import": "./dist/react-virtuoso/index.js",
      "default": "./dist/react-virtuoso/index.js"
    },
    "./tanstack": {
      "types": "./dist/tanstack/index.d.ts",
      "import": "./dist/tanstack/index.js",
      "default": "./dist/tanstack/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js",
      "default": "./dist/vue/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js",
      "default": "./dist/worker/index.js"
    },
    "./worker/runtime": {
      "types": "./dist/worker/runtime.d.ts",
      "import": "./dist/worker/runtime.js",
      "default": "./dist/worker/runtime.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm test && pnpm typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@tanstack/react-virtual": "^3.13.0",
    "react": ">=18",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-virtual": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-virtual": "^3.13.12",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "jsdom": "^26.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsup": "^8.5.0",
    "vitest": "^3.2.4",
    "vue": "^3.5.40"
  }
}
